generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // Optional contact phone number. Set by the user via /api/auth/me PATCH
  // (Settings page). Shown publicly on that user's Property listings so
  // visitors can contact the owner directly (call/WhatsApp) — see
  // biens/[id]/page.tsx.
  phone             String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes  VerificationCode[]
  uploads            FileUpload[]
  notifications      Notification[]
  notifPrefs         NotificationPreferences?
  orders             Order[]
  withdrawals        Withdrawal[]
  oauthAccounts      OAuthAccount[]
  adminActions       AdminAction[]
  properties         Property[]
  favorites          Favorite[]
  subscription       Subscription?
  investmentProjects InvestmentProject[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")
  promoBanners       PromoBanner[]

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Homepage promo banner — admin-managed ad slot (ImmoLink's own promos or
// a paying client's). Only one banner is meant to be ACTIVE at a time; the
// homepage renders the most recently created active row. Managed from
// /admin/promotions (upload image via the existing /api/upload pipeline,
// set an optional click-through link, toggle active, delete old ones) —
// no redeploy needed to change the ad.
// ───────────────────────────────────────────────────────────────────────
model PromoBanner {
  id          String   @id @default(cuid())
  imageUrl    String
  linkUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

// ───────────────────────────────────────────────────────────────────────
// ImmoLink Sénégal — real estate listings. Replaces the mock data in
// frontend/src/lib/mock/immolink.ts (kept there now for presentation-only
// helpers: price formatting, badge/txn colors, marketing copy).
//
// `price` is FCFA (XOF), which has no subunit — 1 = 1 FCFA, same convention
// as Order.amount. `unit` distinguishes a sale price from a monthly rent.
// ───────────────────────────────────────────────────────────────────────
model Property {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  type      String // Villa | Appartement | Terrain | Bureau
  txn       String // Vente | Location
  city      String
  quartier  String
  price     Int // FCFA
  unit      String   @default("") // "" | "/mois"
  beds      Int      @default(0)
  baths     Int      @default(0)
  surface   Int
  badge     String   @default("Nouveau") // Premium | Nouveau | Coup de cœur | Opportunité
  image     String
  image2    String
  image3    String
  photos    Int      @default(1)
  views     Int      @default(0)
  favs      Int      @default(0)
  agent     String
  agency    String
  charges   String   @default("Non applicable")
  status    String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitRequests VisitRequest[]
  viewEvents    PropertyView[]
  favorites     Favorite[]

  @@index([txn, status])
  @@index([city])
  @@index([ownerId])
}

// ───────────────────────────────────────────────────────────────────────
// Time-windowed view log backing the dashboard's "Vues (7j)" KPI —
// `Property.views` stays a fast denormalized all-time counter (incremented
// alongside each insert here), this table is what makes a real 7-day
// window (and week-over-week trend) possible.
// ───────────────────────────────────────────────────────────────────────
model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Real per-user favorites (logged-in only — anonymous visitors keep the
// client-only localStorage favorites, see src/lib/useFavorites.ts).
// `Property.favs` stays a fast denormalized counter, incremented/decremented
// alongside create/delete here so existing card/detail displays stay cheap.
// ───────────────────────────────────────────────────────────────────────
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([propertyId, createdAt])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Seller subscription — one row per user, activated/renewed by the Bictorys
// webhook when a `pack_subscription` Order is PAID (see
// api/webhooks/bictorys/route.ts onPaid + lib/server/subscriptions/plans.ts
// for the canonical plan→{amount,quota} catalog). Absence of a row (or an
// expired one) means the free tier (see FREE_LISTING_QUOTA) — read paths
// treat `renewsAt < now` as lazily-expired rather than running a cron to
// flip status, so no background job is needed to keep this correct.
// ───────────────────────────────────────────────────────────────────────
model Subscription {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         String // STANDARD | PREMIUM
  listingQuota Int
  status       String   @default("ACTIVE") // ACTIVE | CANCELLED
  renewsAt     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// "Demander une visite" — a lead-gen form on the property detail page.
// No auth required to submit (same rationale as /api/auth/signup: this is
// a public, pre-session action with no ambient authority to protect, so
// the route skips verifyCsrf). The property owner is notified via the
// existing Notification system (see notifications/templates.ts).
// ───────────────────────────────────────────────────────────────────────
model VisitRequest {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  message     String?
  preferredAt DateTime?
  status      String    @default("PENDING") // PENDING | CONTACTED | DONE | CANCELLED
  createdAt   DateTime  @default(now())

  @@index([propertyId, createdAt])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Projets d'investissement — publiés directement par les porteurs de
// projet (promoteurs, propriétaires de programmes neufs). Remplace le
// mock PROGRAMS de lib/mock/immolink.ts. Pas de quota, pas de modération
// admin, pas de suivi financier (montant levé, ticket minimum) — un
// marketplace publish-and-discover, comme Property.
// ───────────────────────────────────────────────────────────────────────
model InvestmentProject {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  type          String // Résidentiel | Terrain | Bureau | Mixte
  city          String
  quartier      String
  priceFrom     Int // FCFA, "à partir de"
  lotsLabel     String // texte libre : "48 lots", "120 appartements"
  status        String   @default("En cours") // texte libre : "En cours" | "Sur plan" | "Livré"
  developerName String? // nom public du projet/promoteur, distinct du nom du compte
  image         String
  image2        String?
  image3        String?
  recordStatus  String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  interests InvestmentInterest[]

  @@index([city])
  @@index([ownerId])
  @@index([recordStatus, createdAt])
}

model InvestmentInterest {
  id        String            @id @default(cuid())
  projectId String
  project   InvestmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  message   String?
  status    String            @default("PENDING") // PENDING | CONTACTED | DONE
  createdAt DateTime          @default(now())

  @@index([projectId, createdAt])
}
